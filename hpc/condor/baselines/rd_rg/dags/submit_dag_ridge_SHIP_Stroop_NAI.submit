# The environment
universe       = vanilla
getenv         = True
request_memory = 32GB
request_disk   = 10GB
request_cpus   = $(req_cpu)

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/rd_rg/run_ridge_SHIP_Stroop_NAI.sh

arguments = "$(feature_comb) $(target) $(req_cpu)"
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/rd_rg/condor_logs/SHIP/ml_pipeline/$(target)_$(feature_comb).log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/rd_rg/condor_outputs/SHIP/ml_pipeline/$(target)_$(feature_comb).out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/rd_rg/condor_errors/SHIP/ml_pipeline/$(target)_$(feature_comb).err
Queue
