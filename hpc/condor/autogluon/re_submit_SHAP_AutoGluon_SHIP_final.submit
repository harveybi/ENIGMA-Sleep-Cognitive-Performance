error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_errors/SHIP/SHAP/Stroop_rgo_age_Sleep_Cov_Brain.err
Queue

arguments = Sleep_Cov Memory_rgo_age
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_logs/SHIP/SHAP/Memory_rgo_age_Sleep_Cov.log
