# The environment
universe       = vanilla
getenv         = True
request_memory = 2GB
request_disk   = 1GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/run_SHAP-IQ_AutoGluon_SHIP_htcondor.sh

arguments = Sleep_Cov_Brain_APOE Stroop
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_logs/SHIP/SHAP-IQ/Stroop_Sleep_Cov_Brain_APOE.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_outputs/SHIP/SHAP-IQ/Stroop_Sleep_Cov_Brain_APOE.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_errors/SHIP/SHAP-IQ/Stroop_Sleep_Cov_Brain_APOE.err
Queue

arguments = Sleep_Cov_Brain_APOE_Shuffle Stroop
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_logs/SHIP/SHAP-IQ/Stroop_Sleep_Cov_Brain_APOE_Shuffle.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_outputs/SHIP/SHAP-IQ/Stroop_Sleep_Cov_Brain_APOE_Shuffle.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_errors/SHIP/SHAP-IQ/Stroop_Sleep_Cov_Brain_APOE_Shuffle.err
Queue
