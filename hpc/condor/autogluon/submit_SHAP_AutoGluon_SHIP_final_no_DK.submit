# The environment
universe       = vanilla
getenv         = True
request_memory = 8GB
request_disk   = 4GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/run_SHAP_AutoGluon_SHIP_final_no_DK.sh

