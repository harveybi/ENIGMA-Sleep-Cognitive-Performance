# The environment
universe       = vanilla
getenv         = True
request_memory = 64GB
request_disk   = 64GB
request_cpus   = $(req_cpu)

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/run_AutoGluon_SHIP_Stroop_NAI.sh

# arguments = Sleep Stroop 16
arguments = "$(feature_comb) $(target) $(req_cpu)"
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_logs/SHIP/ml_pipeline/$(target)_$(feature_comb).log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_outputs/SHIP/ml_pipeline/$(target)_$(feature_comb).out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_errors/SHIP/ml_pipeline/$(target)_$(feature_comb).err
Queue
