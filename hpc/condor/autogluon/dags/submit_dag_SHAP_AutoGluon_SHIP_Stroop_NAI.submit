# The environment
universe       = vanilla
getenv         = True
request_memory = 64GB
request_disk   = 64GB
request_cpus   = 2

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/run_SHAP_AutoGluon_SHIP_Stroop_NAI.sh

# arguments = Sleep Stroop
arguments = "$(feature_comb) $(target)"
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_logs/SHIP/SHAP/$(target)_$(feature_comb).log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_outputs/SHIP/SHAP/$(target)_$(feature_comb).out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/AutoGluon/condor_errors/SHIP/SHAP/$(target)_$(feature_comb).err
Queue
