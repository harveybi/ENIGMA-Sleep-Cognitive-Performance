# The environment
universe       = vanilla
getenv         = True
request_memory = 2GB
request_disk   = 1GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/XGBoost/run_XGBoost_SHIP_htcondor.sh

arguments = Sleep_Cov_Brain_APOE_Shuffle Memory
