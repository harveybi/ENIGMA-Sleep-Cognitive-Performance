# The environment
universe       = vanilla
getenv         = True
request_memory = 4GB
request_disk   = 2GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/XGBoost/run_XGBoost_SHIP_APOE_rgo_Age.sh

arguments = Sleep_Cov_Brain_APOE_Shuffle Memory 80 yes
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/XGBoost/condor_logs/SHIP/ml_pipeline/Memory_Sleep_Cov_Brain_APOE.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/XGBoost/condor_outputs/SHIP/ml_pipeline/Memory_Sleep_Cov_Brain_APOE.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/XGBoost/condor_errors/SHIP/ml_pipeline/Memory_Sleep_Cov_Brain_APOE.err
Queue