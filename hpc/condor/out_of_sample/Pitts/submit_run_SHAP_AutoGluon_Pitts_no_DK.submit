# The environment
universe       = vanilla
getenv         = True
request_memory = 8GB
request_disk   = 4GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/Pitts/run_SHAP_AutoGluon_Pitts_no_DK.sh

arguments = Brain Stroop
