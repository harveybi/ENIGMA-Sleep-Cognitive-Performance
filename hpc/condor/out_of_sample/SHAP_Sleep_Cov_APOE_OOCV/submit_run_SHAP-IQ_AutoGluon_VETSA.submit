# The environment
universe       = vanilla
getenv         = True
request_memory = 2GB
request_disk   = 1GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/VETSA/run_SHAP-IQ_AutoGluon_VETSA.sh

arguments = Sleep_Cov_APOE Stroop
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP-IQ/VETSA/Stroop_Sleep_Cov_APOE.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP-IQ/VETSA/Stroop_Sleep_Cov_APOE.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/VETSA/Stroop_Sleep_Cov_APOE.err
Queue

arguments = Sleep_Cov_APOE_Shuffle Stroop
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP-IQ/VETSA/Stroop_Sleep_Cov_APOE_Shuffle.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP-IQ/VETSA/Stroop_Sleep_Cov_APOE_Shuffle.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/VETSA/Stroop_Sleep_Cov_APOE_Shuffle.err
Queue

arguments = Sleep_Cov_APOE Memory
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP-IQ/VETSA/Memory_Sleep_Cov_APOE.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP-IQ/VETSA/Memory_Sleep_Cov_APOE.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/VETSA/Memory_Sleep_Cov_APOE.err
Queue

arguments = Sleep_Cov_APOE_Shuffle Memory
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP-IQ/VETSA/Memory_Sleep_Cov_APOE_Shuffle.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP-IQ/VETSA/Memory_Sleep_Cov_APOE_Shuffle.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/VETSA/Memory_Sleep_Cov_APOE_Shuffle.err
Queue
