# The environment
universe       = vanilla
getenv         = True
request_memory = 4GB
request_disk   = 4GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/VETSA/run_SHAP_AutoGluon_VETSA.sh

arguments = Sleep_Cov Stroop
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP/VETSA/Stroop_Sleep_Cov.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP/VETSA/Stroop_Sleep_Cov.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP/VETSA/Stroop_Sleep_Cov.err
Queue
