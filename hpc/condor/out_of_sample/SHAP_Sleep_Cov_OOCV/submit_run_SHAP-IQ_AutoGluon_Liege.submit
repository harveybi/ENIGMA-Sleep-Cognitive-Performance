# The environment
universe       = vanilla
getenv         = True
request_memory = 2GB
request_disk   = 1GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/Liege/run_SHAP-IQ_AutoGluon_Liege.sh

arguments = Sleep_Cov Stroop
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/Liege/Stroop_Sleep_Cov.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP-IQ/Liege/Stroop_Sleep_Cov.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/Liege/Stroop_Sleep_Cov.err
Queue

arguments = Sleep_Cov Memory
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/Liege/Memory_Sleep_Cov.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP-IQ/Liege/Memory_Sleep_Cov.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/Liege/Memory_Sleep_Cov.err
Queue

arguments = Sleep_Cov Stroop_rgo_age
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/Liege/Stroop_rgo_age_Sleep_Cov.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP-IQ/Liege/Stroop_rgo_age_Sleep_Cov.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/Liege/Stroop_rgo_age_Sleep_Cov.err
Queue

arguments = Sleep_Cov Memory_rgo_age
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/Liege/Memory_rgo_age_Sleep_Cov.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP-IQ/Liege/Memory_rgo_age_Sleep_Cov.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP-IQ/Liege/Memory_rgo_age_Sleep_Cov.err
Queue
