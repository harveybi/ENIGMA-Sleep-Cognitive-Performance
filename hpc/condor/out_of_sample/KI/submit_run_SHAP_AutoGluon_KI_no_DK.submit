error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP_no_DK/KI/Memory_Sleep_Cov_Brain.err
Queue

arguments = Sleep_Cov_Brain_Shuffle Memory
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP_no_DK/KI/Memory_Sleep_Cov_Brain_Shuffle.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP_no_DK/KI/Memory_Sleep_Cov_Brain_Shuffle.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP_no_DK/KI/Memory_Sleep_Cov_Brain_Shuffle.err
Queue

arguments = Sleep_Cov_Brain_APOE Memory
