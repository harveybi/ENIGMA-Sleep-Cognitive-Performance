error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP_no_DK/KI/Memory_Sleep_Cov_Brain_APOE.err
Queue

arguments = Sleep_Cov_Brain_APOE_Shuffle Memory
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP_no_DK/KI/Memory_Sleep_Cov_Brain_APOE_Shuffle.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP_no_DK/KI/Memory_Sleep_Cov_Brain_APOE_Shuffle.out
