# The environment
universe       = vanilla
getenv         = True
request_memory = 8GB
request_disk   = 4GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/KI/run_SHAP_AutoGluon_KI_no_DK.sh

arguments = Brain Memory
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP_no_DK/KI/Memory_Brain.log
output    = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_outputs/SHAP_no_DK/KI/Memory_Brain.out
error     = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_errors/SHAP_no_DK/KI/Memory_Brain.err
Queue

arguments = Sleep_Cov_Brain Memory
log       = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/condor_logs/SHAP_no_DK/KI/Memory_Sleep_Cov_Brain.log
