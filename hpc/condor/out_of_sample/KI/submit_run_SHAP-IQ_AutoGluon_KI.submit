# The environment
universe       = vanilla
getenv         = True
request_memory = 4GB
request_disk   = 4GB
request_cpus   = 1

# Execution
executable = /data/project/sleep_ENIGMA_Cognition/Codes/ENIGMA_Sleep_Cognitive/Code/Out-of-sample_validation/KI/run_SHAP-IQ_AutoGluon_KI.sh

